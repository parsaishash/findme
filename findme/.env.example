# Django settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# Proxy configuration (uncomment if running behind a reverse proxy)
# DJANGO_USE_X_FORWARDED_HOST=1
# DJANGO_USE_X_FORWARDED_PROTO=1

# Session and CSRF cookies (safe defaults for local development)
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# File server behaviour
FILE_SERVER_ROOT=./data
TOKEN_EXPIRY_HOURS=1
SHARE_LINK_EXPIRY_HOURS=24
FINDME_DEFAULT_THEME=light
# Legacy name supported for backward compatibility
# FILESERVER_DEFAULT_THEME=light

# Optional Traefik integration (used by docker-compose.yml)
TRAEFIK_HOST=files.example.com
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=le
TRAEFIK_ACME_EMAIL=admin@example.com
